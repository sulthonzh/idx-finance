{
  "name": "idx-finance",
  "version": "1.0.0",
  "description": "TypeScript library + CLI for Indonesian Stock Exchange (IDX) data",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "idx": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "idx",
    "indonesia",
    "stock",
    "finance",
    "ihsg",
    "bursa",
    "saham"
  ],
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^13.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
